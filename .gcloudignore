# Upload filter for `gcloud run deploy --source .` (replaces .gitignore for gcloud).
# The built console (apps/dashboard/dist) MUST be uploaded: build it before deploying.
.gcloudignore
.git/
.github/
.venv/
venv/
.local/
.local-*/
.taste-skill/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
*.egg-info/
*.tsbuildinfo
node_modules/
test-results/
playwright-report/
tests/
third_party/
.env
.env.*
!.env.example
*.db
*.sqlite3
*.sqlite3-*
*.log
*.pem
*.key
runtime-secrets.json
fixture-credentials.json
deploy/gcp/.generated-*
apps/dashboard/src/
apps/dashboard/public/
apps/dashboard/e2e/
