{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hades-mirage.invalid/v1/investigation.schema.json",
  "title": "investigation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "case_version",
    "summary",
    "confidence",
    "claims",
    "alternative_explanations",
    "recommended_response"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence_event_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "evidence_event_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "alternative_explanations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "recommended_response": {
      "enum": [
        "monitor",
        "review",
        "restrict",
        "consider_deception"
      ]
    }
  }
}
