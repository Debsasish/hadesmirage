{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hades-mirage.invalid/v1/policy.schema.json",
  "title": "policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "default_effect",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "default_effect": {
      "const": "deny"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect",
          "principal_ids",
          "tool",
          "actions",
          "resource_prefix",
          "approval_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "principal_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true
          },
          "resource_prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
