# Native local profile. No Docker is used.
MIRAGE_PROFILE=P1-native
MIRAGE_DATA_DIR=.local
MIRAGE_API_PORT=8787
MIRAGE_BACKEND_PORT=8788
MIRAGE_ALLOWED_ORIGINS=["http://127.0.0.1:8787","http://localhost:8787","http://127.0.0.1:5173","http://localhost:5173"]
# Optional shared PostgreSQL; leave blank for the local SQLite/WAL profile.
MIRAGE_DATABASE_URL=
MIRAGE_MODEL_PROVIDER=fixture
MIRAGE_GEMINI_PROJECT=
# Optional Gemini API (Google AI Studio) key. Server-side only; never commit it.
# With a key, the project is optional and the Gemini Developer API endpoint is used.
MIRAGE_GEMINI_API_KEY=
MIRAGE_GEMINI_ENDPOINT=auto
MIRAGE_GEMINI_LOCATION=global
MIRAGE_GEMINI_MODEL=
# Live provider egress needs explicit data/cost approval and workload credentials.
MIRAGE_MODEL_EGRESS_APPROVED=false
MIRAGE_DECOY_MODEL_WORDING=false
MIRAGE_SESSION_TTL_SECONDS=900
MIRAGE_DECOY_REQUEST_BUDGET=100
MIRAGE_MAX_ENGAGEMENTS=10
MIRAGE_MODEL_CALL_BUDGET=100
# Shared investigation/question cap per case; report summaries have the same per-report cap.
MIRAGE_MODEL_CASE_CALL_BUDGET=3
MIRAGE_MODEL_MAX_PENDING=4
MIRAGE_MODEL_INPUT_BYTES=65536
MIRAGE_MODEL_TIMEOUT_SECONDS=12
MIRAGE_EVENT_RETENTION_DAYS=7
MIRAGE_LOCAL_LOGIN=true
# Set false before any non-local deployment; native login is not enterprise SSO.

# Optional Telegram bot (disabled by default). Never commit a real token. See docs\telegram.md.
# MIRAGE_TELEGRAM_MODE=disabled          # disabled | polling | webhook
# MIRAGE_TELEGRAM_BOT_TOKEN=             # from @BotFather; keep it out of source control
# MIRAGE_TELEGRAM_WEBHOOK_SECRET=        # webhook mode only: 24+ chars of A-Z a-z 0-9 _ -
# MIRAGE_TELEGRAM_API_BASE=https://api.telegram.org
# MIRAGE_TELEGRAM_TENANT=tenant-demo
# MIRAGE_PUBLIC_URL=http://127.0.0.1:8787  # used for links in Telegram messages
