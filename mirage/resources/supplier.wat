(module
  (memory (export "memory") 1 1)
  (global $requests (mut i32) (i32.const 0))
  (global $changes (mut i32) (i32.const 0))
  (data (i32.const 0) "{\"supplier_id\":\"decoy-supplier-001\",\"name\":\"Northstar Research Supply\",\"category\":\"Laboratory equipment\",\"status\":\"active\",\"synthetic\":true,\"simulated\":true}\00")
  (data (i32.const 512) "{\"supplier_id\":\"decoy-supplier-002\",\"name\":\"Aurora Field Systems\",\"category\":\"Field equipment\",\"status\":\"active\",\"synthetic\":true,\"simulated\":true}\00")
  (data (i32.const 1024) "{\"invoice_id\":\"decoy-invoice-001\",\"supplier_id\":\"decoy-supplier-001\",\"total_minor\":84500,\"currency\":\"SIM\",\"status\":\"matched\",\"synthetic\":true,\"simulated\":true}\00")
  (data (i32.const 1536) "{\"status\":\"simulated\",\"message\":\"Administrative request recorded in the synthetic workspace. No real system was changed.\",\"synthetic\":true,\"simulated\":true}\00")
  (data (i32.const 2048) "{\"status\":\"unsupported\",\"message\":\"This synthetic supplier service supports bounded catalogue operations only.\",\"synthetic\":true,\"simulated\":true}\00")
  (data (i32.const 2560) "{\"invoice_id\":\"decoy-invoice-002\",\"supplier_id\":\"decoy-supplier-002\",\"total_minor\":84500,\"currency\":\"SIM\",\"status\":\"matched\",\"synthetic\":true,\"simulated\":true}\00")
  (func (export "restore") (param $requests i32) (param $changes i32)
    (global.set $requests (local.get $requests))
    (global.set $changes (local.get $changes)))
  (func (export "requests") (result i32) (global.get $requests))
  (func (export "changes") (result i32) (global.get $changes))
  (func (export "respond") (param $operation i32) (param $variant i32) (result i32)
    (global.set $requests (i32.add (global.get $requests) (i32.const 1)))
    (if (i32.eq (local.get $operation) (i32.const 1))
      (then (return (i32.mul (i32.and (local.get $variant) (i32.const 1)) (i32.const 512)))))
    (if (i32.eq (local.get $operation) (i32.const 2))
      (then (return (i32.add (i32.const 1024) (i32.mul (i32.and (local.get $variant) (i32.const 1)) (i32.const 1536))))))
    (if (i32.eq (local.get $operation) (i32.const 3))
      (then
        (global.set $changes (i32.add (global.get $changes) (i32.const 1)))
        (return (i32.const 1536))))
    (i32.const 2048))
  (func (export "length") (param $ptr i32) (result i32)
    (local $length i32)
    (block $done
      (loop $scan
        (br_if $done (i32.eqz (i32.load8_u (i32.add (local.get $ptr) (local.get $length)))))
        (local.set $length (i32.add (local.get $length) (i32.const 1)))
        (br $scan)))
    (local.get $length))
)
