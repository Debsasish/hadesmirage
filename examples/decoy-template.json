{
  "template_id": "supplier-portal-v1",
  "version": "1.0",
  "protocol": "http-json",
  "mode": "bounded-emulation",
  "synthetic_only": true,
  "live_credentials_allowed": false,
  "arbitrary_execution_allowed": false,
  "network_egress_allowed": false,
  "ttl_seconds": 900,
  "max_requests": 100,
  "max_model_output_tokens": 8000,
  "max_concurrent_sessions": 10,
  "routes": [
    "/supplier/lookup",
    "/invoice/compare",
    "/admin/tools"
  ],
  "fake_actions": [
    "read_supplier",
    "compare_invoice",
    "simulate_change_request"
  ],
  "model_broker_location": "control-plane",
  "fallback": "static-template-response",
  "initial_records": [
    {
      "supplier_id": "demo-001",
      "name": "Example Components Demo",
      "account_ref": "SYNTHETIC-NONFUNCTIONAL-001"
    }
  ]
}
